# Managed by clamshield
[Unit]
Description=ClamShield interrupted file-operation recovery
After=clamshield-clamd.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -B /opt/clamshield/entry.py recover
User=root
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=512M
TasksMax=16
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=120
# Root bridge and recovery use native authorization and held directory handles.
# Document roots can live outside /home, so filesystem writes cannot be limited
# to a static home-directory allowlist without breaking supported custom roots.
