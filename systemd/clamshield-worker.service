# Managed by clamshield
[Unit]
Description=ClamShield website scan worker
After=clamav-daemon.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -B /opt/clamshield/entry.py worker
User=root
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUQuota=100%
MemoryMax=1G
TasksMax=32
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/clamshield
ReadWritePaths=-/run/clamshield-native -/var/lib/clamav/clamshield-snapshots
PrivateTmp=true
TimeoutStartSec=infinity
