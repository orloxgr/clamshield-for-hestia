# Managed by clamshield
[Unit]
Description=ClamShield personal native Hestia Bell notifications

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -B /opt/clamshield/entry.py notifications
User=root
UMask=0077
Nice=15
CPUQuota=25%
MemoryMax=256M
TasksMax=16
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/clamshield /usr/local/hestia/data/users /usr/local/hestia/log
PrivateTmp=true
TimeoutStartSec=60
